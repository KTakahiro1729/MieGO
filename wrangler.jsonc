{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miego",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "GameRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "GameRoom"
      ]
    }
  ],
  "previews": {
    "durable_objects": {
      "bindings": [
        {
          "name": "ROOMS",
          "class_name": "GameRoom"
        }
      ]
    },
    "vars": {
      "TURNSTILE_SITE_KEY": "0x4AAAAAAFa_cYtTAe8aM3OA"
    }
  },
  "vars": {
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFa_cYtTAe8aM3OA"
  }
}
