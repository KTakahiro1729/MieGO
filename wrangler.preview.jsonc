{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "miego",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-17",
  "analytics_engine_datasets": [
    {
      "binding": "STATS",
      "dataset": "miego_play_style"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "previews": {
    "vars": {
      "TURNSTILE_SITE_KEY": "0x4AAAAAAFa_cYtTAe8aM3OA"
    }
  }
}
